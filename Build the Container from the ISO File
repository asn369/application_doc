# 1. Mount the ISO
mkdir -p /mnt/rocky-iso
mount -o loop,ro Rocky-9.5-x86_64-dvd.iso /mnt/rocky-iso

# 2. Create a temporary rootfs directory
mkdir -p /var/tmp/rocky-9-rootfs

# 3. Create a temporary DNF repository file pointing to the mounted ISO
cat << 'EOF' > /tmp/rocky-iso.repo
[iso-baseos]
name=Rocky Linux 9 ISO - BaseOS
baseurl=file:///mnt/rocky-iso/BaseOS
gpgcheck=0
enabled=1

[iso-appstream]
name=Rocky Linux 9 ISO - AppStream
baseurl=file:///mnt/rocky-iso/AppStream
gpgcheck=0
enabled=1
EOF

# 4. Install a minimal OS into the target directory
dnf --installroot=/var/tmp/rocky-9-rootfs \
    --releasever=9 \
    --config=/tmp/rocky-iso.repo \
    -y groupinstall "Minimal Install"

# 5. Import the directory into Warewulf
wwctl image import /var/tmp/rocky-9-rootfs rocky-9 --syncuser

# 6. Cleanup
umount /mnt/rocky-iso
rm -rf /var/tmp/rocky-9-rootfs /tmp/rocky-iso.repo
